{
  "name": "wise-hackathon-tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reset": "tsx scripts/reset.ts",
    "thin": "tsx --import ./src/loadSecrets.ts src/thin.ts",
    "tool": "tsx --import ./src/loadSecrets.ts src/main.ts",
    "time-fix": "tsx --import ./src/loadSecrets.ts scripts/time-fix.ts",
    "deploy-watch": "tsx scripts/deploy-watch.ts",
    "doctor": "tsx scripts/doctor.ts",
    "post-reports": "tsx --import ./src/loadSecrets.ts scripts/post-reports.ts",
    "full-run": "tsx --import ./src/loadSecrets.ts scripts/full-run.ts",
    "approve-latest": "tsx --import ./src/loadSecrets.ts scripts/approve-latest.ts",
    "counted-runs": "tsx scripts/counted-runs.ts",
    "demo-start": "tsx scripts/demo-start.ts",
    "demo-stop": "tsx scripts/demo-stop.ts",
    "seed-spike": "node ../monitoring/seed-spike.mjs",
    "demo-both": "tsx --import ./src/loadSecrets.ts scripts/post-reports.ts --problem both",
    "clear-monitor": "tsx --import ./src/loadSecrets.ts scripts/clear-monitor.ts"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
